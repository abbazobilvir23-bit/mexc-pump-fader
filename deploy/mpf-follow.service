[Unit]
Description=MEXC pump-fader: paper-торговля по сигналам канала
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
Environment=PYTHONUNBUFFERED=1
# ВНИМАНИЕ: подставь свой путь к проекту
WorkingDirectory=%h/Документы/mexc-pump-fader
ExecStart=%h/Документы/mexc-pump-fader/.venv/bin/mpf follow \
    --config config/optimized_5m.json \
    --poll 30 \
    --take-existing 5 \
    --max-concurrent 5 \
    --out data/follow
Restart=always
RestartSec=10

[Install]
WantedBy=default.target