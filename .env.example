# Скопируй в .env и заполни. Нужно ТОЛЬКО для live-торговли.
# Для сканера и бэктеста ключи не нужны — публичные данные MEXC доступны без них.

# Ключи MEXC (создавать с правом "Futures trade", БЕЗ права вывода!)
MEXC_API_KEY=
MEXC_API_SECRET=

# Режим: paper | live
MPF_MODE=paper

# Ограничения риска
MPF_MAX_CONCURRENT_POSITIONS=3